// Video "__TITLE__": isi BASE_SCENES dengan scene-scene video ini. Tiap scene = data (dialog, ekspresi, bidikan
// kamera, sisipan layar); waktu di dalam scene dalam detik, di dalam sisipan dihitung dari awal sisipan.
// Contoh lengkap semua jenis bidikan, sisipan, dan efek: src/videos/VueTutorial/scenes.tsx.

const shot = (from: number, dur: number, start: Shot["start"], extra: Partial<Shot> = {}): Shot => ({ from, dur, start, ...extra });

// Jendela ketikan (detik, waktu sisipan) dari baris `cmd` terminal: dasar efek suara ketikan.
const termTyping = (lines: readonly TermLine[]): { at: number; dur: number }[] => lines.filter((l) => l.kind === "cmd").map((l) => ({ at: l.at, dur: l.text.length / (l.speed ?? 22) }));

const DEMO: readonly TermLine[] = [
  { at: 0.5, kind: "cmd", text: "npm run dev", speed: 12 },
  { at: 1.8, kind: "ok", text: "  ➜  Local:   http://localhost:5173/" },
];

